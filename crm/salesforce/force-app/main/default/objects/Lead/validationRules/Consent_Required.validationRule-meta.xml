<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Consent_Required</fullName>
    <active>true</active>
    <description>Blocks a lead that did not give consent.</description>
    <errorConditionFormula>NOT(Consent_Given__c)</errorConditionFormula>
    <errorMessage>Consent is required.</errorMessage>
</ValidationRule>
