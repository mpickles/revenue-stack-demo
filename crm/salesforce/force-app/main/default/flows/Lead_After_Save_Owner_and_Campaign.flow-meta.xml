    <description>Runs after a lead is saved. Adds a new lead to its campaign with the status Responded, and sets the owner to a queue. Rules are in docs/roadwren-brief.md.</description>
    <environments>Default</environments>
    <formulas>
        <description>The name of the lead&apos;s catch-all campaign: its Lead Source, then &quot; - Other&quot;.</description>
        <name>CatchAllName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.LeadSource}) &amp; &quot; - Other&quot;</expression>
    </formulas>
    <formulas>
        <description>True when the lead is being created, false when it is being updated.</description>
        <name>IsNewLead</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>True when the Flow should set the owner: the lead is new or its stage or Fleet Size just changed, its stage is New, MQL or Nurture, and it is new or still owned by a queue.</description>
        <name>RouteOwner</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
    ISNEW(),
    ISCHANGED({!$Record.Lifecycle_Stage__c}),
    ISCHANGED({!$Record.Fleet_Size__c})
  ),
  OR(
    ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;New&quot;),
    ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;MQL&quot;),
    ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;Nurture&quot;)
  ),
  OR(
    ISNEW(),
    BEGINS({!$Record.OwnerId}, &quot;00G&quot;)
  )
)</expression>
    </formulas>
