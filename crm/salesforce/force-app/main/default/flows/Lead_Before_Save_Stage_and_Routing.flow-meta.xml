    <description>Runs before a lead is saved. Sets Lead Source, Segment, Expected Annual Value, Lifecycle Stage, Stage Reason, the stage dates and Lead Email Copy. Rules are in docs/roadwren-brief.md. Does not set the owner.</description>
    <environments>Default</environments>
    <formulas>
        <description>The lead&apos;s channel. UTM Medium decides it. With no UTM Medium, the Referring Domain decides it.</description>
        <name>Channel</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!$Record.UTM_Medium__c})),
  CASE(LOWER({!$Record.UTM_Medium__c}),
    &quot;cpc&quot;, &quot;Paid Search&quot;,
    &quot;ppc&quot;, &quot;Paid Search&quot;,
    &quot;paid_social&quot;, &quot;Paid Social&quot;,
    &quot;email&quot;, &quot;Email&quot;,
    &quot;referral&quot;, &quot;Referral&quot;,
    &quot;Other&quot;),
  IF(
    ISBLANK({!$Record.Referring_Domain__c}),
    &quot;Direct&quot;,
    IF(
      OR(
        CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;|&quot;, &quot;.chatgpt.com|&quot;),
        CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;|&quot;, &quot;.perplexity.ai|&quot;),
        CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;|&quot;, &quot;.gemini.google.com|&quot;),
        CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;|&quot;, &quot;.copilot.microsoft.com|&quot;),
        CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;|&quot;, &quot;.claude.ai|&quot;)
      ),
      &quot;AI Search&quot;,
      IF(
        OR(
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.google.&quot;),
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.bing.&quot;),
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.duckduckgo.&quot;),
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.yahoo.&quot;),
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.ecosia.&quot;),
          CONTAINS(&quot;.&quot; &amp; {!DomainLower} &amp; &quot;.&quot;, &quot;.brave.&quot;)
        ),
        &quot;Organic Search&quot;,
        &quot;Referral&quot;
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <description>The lead&apos;s Referring Domain in lower case.</description>
        <name>DomainLower</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.Referring_Domain__c})</expression>
    </formulas>
    <formulas>
        <name>FirstMQLDateOrNow</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!$Record.First_MQL_Date__c}), NOW(), {!$Record.First_MQL_Date__c})</expression>
    </formulas>
    <formulas>
        <name>FirstResponseDateOrNow</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!$Record.First_Response_Date__c}), NOW(), {!$Record.First_Response_Date__c})</expression>
    </formulas>
    <formulas>
        <description>True when a free email lead must be held for review: the email is free, and the lead is new or is not already MQL. Already MQL means a person released it.</description>
        <name>HoldForReview</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  {!IsFreeEmail},
  OR(
    {!IsNewLead},
    NOT(ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;MQL&quot;))
  )
)</expression>
    </formulas>
    <formulas>
        <description>True when the email ends in @gmail.com, @yahoo.com, @hotmail.com or @outlook.com. Compared in lower case.</description>
        <name>IsFreeEmail</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  RIGHT(LOWER({!$Record.Email}), 10) = &quot;@gmail.com&quot;,
  RIGHT(LOWER({!$Record.Email}), 10) = &quot;@yahoo.com&quot;,
  RIGHT(LOWER({!$Record.Email}), 12) = &quot;@hotmail.com&quot;,
  RIGHT(LOWER({!$Record.Email}), 12) = &quot;@outlook.com&quot;
)</expression>
    </formulas>
    <formulas>
        <description>True when the lead is being created, false when it is being updated.</description>
        <name>IsNewLead</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>True when the Flow should set the stage: the lead is new, or its Fleet Size changed and no rep has taken it (stage is blank, New, MQL or Nurture).</description>
        <name>JudgeStage</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISNEW(),
  AND(
    ISCHANGED({!$Record.Fleet_Size__c}),
    OR(
      ISBLANK(TEXT({!$Record.Lifecycle_Stage__c})),
      ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;New&quot;),
      ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;MQL&quot;),
      ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;Nurture&quot;)
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>MQLCountPlusOne</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.MQL_Count__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
